{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datasitr.com/schemas/scc-canonical-v1.json",
  "title": "SDAIA SCC Canonical Form v1",
  "description": "Machine-readable canonical form of a Standard Contractual Clause document under the SDAIA Regulation on Personal Data Transfer Outside the Kingdom (1 September 2024).",
  "type": "object",
  "required": [
    "scc_id",
    "rule_bundle_required",
    "parties",
    "subject_matter",
    "obligations",
    "data_subject_rights",
    "security",
    "breach_notification",
    "onward_transfers",
    "audit_rights",
    "governing_law",
    "term",
    "liability",
    "annex_a_tra",
    "annex_b_toms_ref",
    "annex_c_subprocessors",
    "signatures"
  ],
  "properties": {
    "scc_id": {
      "type": "string",
      "pattern": "^SCC-[0-9]{4}-[0-9]{2}-[0-9]{3,}$",
      "description": "Stable identifier. Format: SCC-YYYY-MM-NNN"
    },
    "rule_bundle_required": {
      "type": "string",
      "description": "Identifier of the rule bundle under which this SCC was constructed. Example: sdaia-scc-v1.0-2024-09-02"
    },
    "parties": {
      "type": "object",
      "required": ["exporter", "importer"],
      "properties": {
        "exporter": { "$ref": "#/$defs/party" },
        "importer": { "$ref": "#/$defs/party" }
      }
    },
    "subject_matter": {
      "type": "object",
      "required": ["data_categories", "data_subjects", "sensitive_categories_art18", "purpose", "transfer_basis", "duration"],
      "properties": {
        "data_categories": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "data_subjects": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "sensitive_categories_art18": {
          "type": "array",
          "items": {
            "enum": ["none", "health", "biometric", "genetic", "criminal", "financial", "religious", "ethnic", "political", "union_membership"]
          }
        },
        "purpose": { "type": "string", "minLength": 1 },
        "transfer_basis": {
          "enum": ["adequacy_decision", "standard_contractual_clauses", "binding_common_rules", "certificate_of_accreditation", "explicit_consent", "vital_interests", "public_interest", "legal_claims"]
        },
        "duration": {
          "type": "object",
          "required": ["start"],
          "properties": {
            "start": { "type": "string", "format": "date" },
            "end": { "type": "string", "format": "date" },
            "annual_review": { "type": "boolean" }
          }
        }
      }
    },
    "obligations": {
      "type": "object",
      "required": ["exporter", "importer"],
      "properties": {
        "exporter": { "$ref": "#/$defs/obligation_list" },
        "importer": { "$ref": "#/$defs/obligation_list" }
      }
    },
    "data_subject_rights": {
      "type": "object",
      "required": ["response_window_days"],
      "properties": {
        "response_window_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "subject_rights_api_provided": { "type": "boolean" }
      }
    },
    "security": {
      "type": "object",
      "required": ["toms_snapshot_ref", "toms_snapshot_hash"],
      "properties": {
        "toms_snapshot_ref": { "type": "string" },
        "toms_snapshot_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "breach_notification": {
      "type": "object",
      "required": ["exporter_notification_window_hours", "sdaia_notification_window_hours"],
      "properties": {
        "exporter_notification_window_hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 168
        },
        "sdaia_notification_window_hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 72
        }
      }
    },
    "onward_transfers": {
      "type": "object",
      "required": ["permitted"],
      "properties": {
        "permitted": { "type": "boolean" },
        "sub_processor_list_ref": { "type": "string" }
      }
    },
    "audit_rights": {
      "type": "object",
      "required": ["notice_period_days", "scope"],
      "properties": {
        "notice_period_days": { "type": "integer", "minimum": 1 },
        "scope": { "type": "string", "minLength": 1 }
      }
    },
    "governing_law": {
      "type": "object",
      "required": ["jurisdiction", "dispute_forum"],
      "properties": {
        "jurisdiction": { "type": "string" },
        "dispute_forum": { "type": "string" }
      }
    },
    "term": {
      "type": "object",
      "required": ["effective_date", "termination_notice_days"],
      "properties": {
        "effective_date": { "type": "string", "format": "date" },
        "termination_notice_days": { "type": "integer", "minimum": 1 }
      }
    },
    "liability": {
      "type": "object",
      "required": ["cap_amount_sar", "rationale_ref"],
      "properties": {
        "cap_amount_sar": {
          "oneOf": [
            { "type": "number", "minimum": 0 },
            { "const": "_HUMAN_REVIEW_" }
          ]
        },
        "rationale_ref": { "type": "string" }
      }
    },
    "annex_a_tra": {
      "type": "object",
      "required": ["tra_id", "risk_level", "approved_at", "expires_at"],
      "properties": {
        "tra_id": {
          "type": "string",
          "pattern": "^TRA-[0-9]{4}-[0-9]{2}-[0-9]{3,}$"
        },
        "risk_level": { "enum": ["low", "medium", "high"] },
        "approved_at": { "type": "string", "format": "date" },
        "expires_at": { "type": "string", "format": "date" }
      }
    },
    "annex_b_toms_ref": { "type": "string" },
    "annex_c_subprocessors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "service", "country", "data_categories", "safeguard"],
        "properties": {
          "name": { "type": "string" },
          "service": { "type": "string" },
          "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
          "data_categories": { "type": "array", "items": { "type": "string" } },
          "safeguard": { "type": "string" }
        }
      }
    },
    "signatures": {
      "type": "object",
      "required": ["exporter", "importer"],
      "properties": {
        "exporter": { "$ref": "#/$defs/signature" },
        "importer": { "$ref": "#/$defs/signature" }
      }
    }
  },
  "$defs": {
    "party": {
      "type": "object",
      "required": ["legal_name", "cr_number", "registered_address", "role"],
      "properties": {
        "legal_name": { "type": "string", "minLength": 1 },
        "cr_number": { "type": "string", "minLength": 1 },
        "registered_address": { "type": "string", "minLength": 1 },
        "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "role": { "enum": ["CONTROLLER", "PROCESSOR", "SUB_PROCESSOR"] }
      }
    },
    "obligation_list": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text_ref", "committed"],
        "properties": {
          "id": { "type": "string" },
          "text_ref": { "type": "string" },
          "committed": { "type": "boolean" }
        }
      },
      "minItems": 1
    },
    "signature": {
      "type": "object",
      "required": ["name", "title", "signed_at"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "signed_at": { "type": "string", "format": "date-time" },
        "signature_ref": { "type": "string" }
      }
    }
  }
}
