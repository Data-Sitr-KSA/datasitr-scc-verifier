{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datasitr.com/schemas/evidence-credential-v1.json",
  "title": "DataSitr Evidence Credential v1",
  "description": "W3C Verifiable Credential v2.0 envelope for pieces of evidence referenced by an SCC: TRA records, TOMs snapshots, sub-processor registry entries, processing records. Deterministically signed so third parties can verify evidence independently.",
  "type": "object",
  "required": ["@context", "type", "id", "issuer", "validFrom", "credentialSubject", "proof"],
  "properties": {
    "@context": {
      "type": "array",
      "items": { "type": "string", "format": "uri" },
      "contains": { "const": "https://www.w3.org/ns/credentials/v2" }
    },
    "type": {
      "type": "array",
      "items": { "type": "string" },
      "contains": { "const": "DataSitrEvidence" }
    },
    "id": { "type": "string", "format": "uri" },
    "issuer": { "type": "string", "format": "uri" },
    "validFrom": { "type": "string", "format": "date-time" },
    "validUntil": { "type": "string", "format": "date-time" },
    "credentialSubject": {
      "oneOf": [
        { "$ref": "#/$defs/tra_evidence" },
        { "$ref": "#/$defs/toms_evidence" },
        { "$ref": "#/$defs/subprocessor_evidence" }
      ]
    },
    "proof": {
      "type": "object",
      "required": ["type", "created", "verificationMethod", "proofPurpose", "proofValue"],
      "properties": {
        "type": { "const": "Ed25519Signature2020" },
        "created": { "type": "string", "format": "date-time" },
        "verificationMethod": { "type": "string" },
        "proofPurpose": { "const": "assertionMethod" },
        "proofValue": { "type": "string" }
      }
    }
  },
  "$defs": {
    "tra_evidence": {
      "type": "object",
      "required": ["evidence_type", "tra_id", "status", "risk_level", "chain_position", "this_chain_hash"],
      "properties": {
        "evidence_type": { "const": "transfer_risk_assessment" },
        "tra_id": { "type": "string", "pattern": "^TRA-[0-9]{4}-[0-9]{2}-[0-9]{3,}$" },
        "status": { "enum": ["draft", "review", "approved", "rejected", "revoked"] },
        "risk_level": { "enum": ["low", "medium", "high"] },
        "chain_position": { "type": "integer", "minimum": 0 },
        "prev_chain_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "this_chain_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "hmac": { "type": "string", "pattern": "^hmac-sha256:[0-9a-f]{64}$" }
      }
    },
    "toms_evidence": {
      "type": "object",
      "required": ["evidence_type", "snapshot_id", "captured_at", "content_hash"],
      "properties": {
        "evidence_type": { "const": "toms_snapshot" },
        "snapshot_id": { "type": "string" },
        "captured_at": { "type": "string", "format": "date-time" },
        "content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "art19_controls": { "type": "object" }
      }
    },
    "subprocessor_evidence": {
      "type": "object",
      "required": ["evidence_type", "registry_hash", "captured_at"],
      "properties": {
        "evidence_type": { "const": "subprocessor_registry" },
        "registry_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "captured_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
